# ──────────────────────────────────────────────────────────────────────────────
# LeadAnchor API — environment template
# Copy to apps/api/.env (git-ignored) and fill in the blanks. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
DEV_TOOLS=true

# ── PostgreSQL (local: `pnpm db:start` runs Postgres 18 on port 5433) ─────────
# App role is subject to row-level security; the system role bypasses it for
# routing lookups and jobs; the admin URL is used for migrations only.
DATABASE_URL=postgres://leadanchor_app:leadanchor_app@localhost:5433/leadanchor
DATABASE_SYSTEM_URL=postgres://leadanchor_system:leadanchor_system@localhost:5433/leadanchor
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/leadanchor

# ── Secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ──
BETTER_AUTH_SECRET=
DATA_ENCRYPTION_KEY=

# ── AI: Google Gemini (Google AI Studio key) ─────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000
# Optional: a faster model, used when the main one is overloaded (chat replies switch to it at once). Leave empty to never switch models.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ── Telephony + SMS + 10DLC: Telnyx (mandated by the spec) ───────────────────
# "simulator" runs the same call-capture engine locally without a Telnyx account.
TELEPHONY_PROVIDER=simulator
SMS_PROVIDER=simulator
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_WEBHOOK_TOLERANCE_SECS=300

# ── WhatsApp Business Platform (Meta, via a BSP — mandated) ──────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── Email ("dev" keeps emails in the local outbox; "resend" sends through Resend) ─
EMAIL_TRANSPORT=dev
SMTP_URL=
EMAIL_FROM=LeadAnchor <no-reply@leadanchor.local>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Test mode without your own domain: every email goes to this address instead.
EMAIL_TEST_RECIPIENT=

# ── Consent ledger + push: Firebase (named in the spec) ──────────────────────
# CONSENT_LEDGER=local uses the append-only Postgres ledger until Firebase is set up.
# CONSENT_LEDGER=firestore + FIRESTORE_EMULATOR_HOST=localhost:8080 uses the Firebase emulator (needs Java 21).
# CONSENT_LEDGER=local-and-firestore keeps the local ledger and copies every new record to Firestore.
CONSENT_LEDGER=local
FIREBASE_PROJECT_ID=demo-leadanchor
FIRESTORE_EMULATOR_HOST=
# Service-account key file, e.g. ./secrets/firebase-service-account.json (git ignores secrets/).
GOOGLE_APPLICATION_CREDENTIALS=
FCM_ENABLED=false
# The Firebase web app's settings (public by design) and its Web Push key, for phone alerts.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=

# ── File storage (local folder; S3-compatible storage later) ─────────────────
STORAGE_DIR=./storage

# ── Waitlist offers (C-22) go by email until counsel confirms the opt-in wording covers texts ──
WAITLIST_TEXTS_CLEARED=false

# ── Review requests (C-46) go out this many minutes after a job is marked Won (0 = right away) ──
REVIEW_REQUEST_DELAY_MINUTES=30

# ── Quote PDFs: headless Chrome or Edge. Left empty, the one on this computer is used. ──
PDF_BROWSER_PATH=

# ── Card payments: Stripe Connect + Billing (test mode: an sk_test_ key) ───────
# Left empty, the built-in Stripe simulator runs. Setup: docs/integrations/test-mode-setup.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Later phases ─────────────────────────────────────────────────────────────
GBP_CLIENT_ID=

# ── Google Calendar: an OAuth "Web application" client in Google Cloud ───────
# Redirect URI to register: http://localhost:3000/api/calendar/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SCHEDULER_PROVIDER=
