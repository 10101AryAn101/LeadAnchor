{
  "name": "leadanchor",
  "version": "0.1.0",
  "private": true,
  "description": "LeadAnchor — catches missed calls for small service businesses and turns them into booked, paid jobs.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "turbo run dev --filter=@leadanchor/api --filter=@leadanchor/web",
    "db:start": "pnpm --filter @leadanchor/dev-db start",
    "db:migrate": "pnpm --filter @leadanchor/api db:migrate",
    "db:generate": "pnpm --filter @leadanchor/api db:generate",
    "db:studio": "pnpm --filter @leadanchor/api db:studio",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "5.9.3"
  }
}
